{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".agencia/skills-activos"
    ]
  },
  "instructions": [
    "AGENTS.md",
    "asistente-principal.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "enabled": false
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      },
      "enabled": false
    },
    "agencia": {
      "type": "local",
      "command": [
        "python3",
        "scripts/agencia_mcp.py"
      ],
      "enabled": true
    }
  }
}
